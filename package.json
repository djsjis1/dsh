{
  "name": "dsh-plugin-wechat",
  "version": "0.1.0",
  "description": "Scan-to-bind WeChat bridge for DeepSeek Harness: bind an Official Account (free) or a personal WeChat account (padlocal) from the DSH settings page and drive dsh headless from chat. Fully self-contained; removing the plugin removes every trace.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "wechat",
    "wechaty",
    "cordis-plugin"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "optionalDependencies": {
    "wechaty": "^1.20.2",
    "wechaty-puppet-padlocal": "^1.0.5"
  }
}
